generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  mobile    String
  password  String
  role      Role
  isActive  Boolean  @default(true)

  products Product[]
}
model Product {
  id       Int @id @default(autoincrement())
  name     String
  description    String 
  price   Float
  image   String
  userId Int

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  USER
}